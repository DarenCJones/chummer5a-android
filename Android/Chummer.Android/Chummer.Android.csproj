<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <ApplicationId>org.chummer.offline</ApplicationId>
    <ApplicationTitle>Chummer Offline Preview</ApplicationTitle>
    <ApplicationVersion>5</ApplicationVersion>
    <ApplicationDisplayVersion>0.5</ApplicationDisplayVersion>
    <!-- Keep preview runtime callbacks intact; the trimmed Release build aborts
         during Mono startup on the Android API 34 emulator. Revisit with toolchain QA. -->
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chummer.Portable/Chummer.Portable.csproj" />
    <AndroidAsset Include="../../Chummer/data/*.xml" Link="data/%(Filename)%(Extension)" />
    <AndroidAsset Include="../../LICENSE" Link="LICENSE.txt" />
  </ItemGroup>
</Project>
